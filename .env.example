# Set these in the host's secret manager or shell. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only needed when the destination is a group; restrict commands to this user.
TELEGRAM_OPERATOR_USER_ID=

# Optional dedicated Cloudflare relay. With relay enabled, bot token stays in Worker secrets.
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_KEY=
